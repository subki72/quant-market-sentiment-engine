# Application Configuration
APP_NAME="Quant Market Sentiment Engine"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Model Configuration
# Path to local model directory (if present)
MODEL_PATH="./models"

# Hugging Face Hub repository identifier
HF_MODEL_REPO="assubki/fin-sentiment-distilbert"

# Fallback pre-trained financial sentiment model if HF_MODEL_REPO is not yet published
HF_FALLBACK_MODEL="ProsusAI/finbert"

# Model Hyperparameters
MAX_SEQ_LENGTH=64

# Security & CORS
# In production, specify your frontend origin(s):
# e.g., CORS_ORIGINS="https://your-app.vercel.app,http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional API Key Authentication
# Leave empty or unset for public demo mode.
# If set, requests to /predict require the 'X-API-Key' or 'Authorization: Bearer <key>' header.
API_KEY=""

# Throttling / Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
